{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "require-corp" }
      ]
    }
  ],
  "redirects": [
    { "source": "/how-it-works", "destination": "/jpeg-to-png", "statusCode": 301 },
    { "source": "/tools/remove-background", "destination": "/remove-background", "statusCode": 301 },
    { "source": "/blog", "destination": "/", "statusCode": 301 },
    { "source": "/blog/:path*", "destination": "/", "statusCode": 301 },
    { "source": "/learn", "destination": "/", "statusCode": 301 },
    { "source": "/learn/:path*", "destination": "/", "statusCode": 301 }
  ]
}
